function teleportPlayerNoRespawn(player, destination)
	if not player or not player.Parent then return false end
	if not destination or not destination.Parent then return false end

	local character = player.Character
	if not character then return false end

	local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
	if humanoidRootPart then
		humanoidRootPart.Velocity = Vector3.new(0, 0, 0)
		humanoidRootPart.RotVelocity = Vector3.new(0, 0, 0)
		humanoidRootPart.CFrame = destination.CFrame + Vector3.new(0, 5, 0)
	else
		character:SetPrimaryPartCFrame(destination.CFrame + Vector3.new(0, 5, 0))
	end

	if destination.Name:find("Spawn") and not destination.Name:find("Lobby") then
		if not player:FindFirstChild("InDuel") then
			local inDuelTag = Instance.new("BoolValue")
			inDuelTag.Name = "InDuel"
			inDuelTag.Value = true
			inDuelTag.Parent = player
		end
	end

	return true
end

function forceRespawnAndTeleport(player, destination)
	if not player or not player.Parent then return false end

	SpectateControl:FireClient(player, "stop")

	if destination and destination:IsA("SpawnLocation") then
		player.RespawnLocation = destination
	end

	if player:FindFirstChild("InDuel") then
		player.InDuel:Destroy()
	end

	player:LoadCharacter()
	task.wait(1)

	local character = player.Character
	if character then
		local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
		if humanoidRootPart then
			humanoidRootPart.CFrame = destination.CFrame + Vector3.new(0, 5, 0)
		end
	end

	return true
end


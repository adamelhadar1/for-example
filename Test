local MatchManager = {}
MatchManager.ActiveMatches = {}
MatchManager.NextMatchId = 1
MatchManager.PadOccupancies = {
	Pad1 = nil,
	Pad2 = nil,
	Pad3 = nil,
	Pad4 = nil
}

function MatchManager.createMatch(padSet, player1, player2)
	local matchId = MatchManager.NextMatchId
	MatchManager.NextMatchId = MatchManager.NextMatchId + 1

	local match = Match.new(matchId, padSet, player1, player2)
	MatchManager.ActiveMatches[matchId] = match

	match.PlayerConnections["p1_left"] = player1.AncestryChanged:Connect(function()
		if not player1.Parent then
			match:handlePlayerLeft(player1)
			MatchManager.ActiveMatches[matchId] = nil
		end
	end)

	match.PlayerConnections["p2_left"] = player2.AncestryChanged:Connect(function()
		if not player2.Parent then
			match:handlePlayerLeft(player2)
			MatchManager.ActiveMatches[matchId] = nil
		end
	end)

	if padSet == "Pads12" then
		MatchManager.releasePad("Pad1")
		MatchManager.releasePad("Pad2")
	else
		MatchManager.releasePad("Pad3")
		MatchManager.releasePad("Pad4")
	end

	task.spawn(function()
		task.wait(0.5)
		match:startVoting()
	end)

	return match
end

function MatchManager.isPadAvailable(padName)
	return MatchManager.PadOccupancies[padName] == nil
end

function MatchManager.occupyPad(padName, player)
	MatchManager.PadOccupancies[padName] = player
end

function MatchManager.releasePad(padName)
	MatchManager.PadOccupancies[padName] = nil
end

function MatchManager.getPlayerOnPad(padName)
	return MatchManager.PadOccupancies[padName]
end

function MatchManager.getMatchForPlayer(player)
	for matchId, match in pairs(MatchManager.ActiveMatches) do
		if match.IsActive and (match.Player1 == player or match.Player2 == player) then
			return match
		end
	end
	return nil
end


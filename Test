function hasDoubleCoinsGamepass(player)
	if not player or not player.Parent then 
		return false 
	end

	local success, hasPass = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, DOUBLE_COINS_GAMEPASS_ID)
	end)

	if success then
		return hasPass
	else
		warn("⚠️ Failed to check gamepass for " .. player.Name)
		return false
	end
end

function getMultipliedCoins(player, baseAmount)
	local multiplier = 1

	if hasDoubleCoinsGamepass(player) then
		multiplier = 2
		print("💰 " .. player.Name .. " has Double Coins gamepass! (" .. baseAmount .. " x " .. multiplier .. " = " .. (baseAmount * multiplier) .. ")")
	end

	return baseAmount * multiplier
end

-- =======================
-- MAP OFFSET MANAGER
-- =======================
local MapOffsetManager = {}
MapOffsetManager.MapUsage = {}

function MapOffsetManager.getNextOffset(mapName)
	if not MapOffsetManager.MapUsage[mapName] then
		MapOffsetManager.MapUsage[mapName] = 0
	end

	local currentCount = MapOffsetManager.MapUsage[mapName]
	MapOffsetManager.MapUsage[mapName] = currentCount + 1

	local offset = Vector3.new(currentCount * 250, 0, 0)

	print("🗺️ Map '" .. mapName .. "' - Instance #" .. (currentCount + 1) .. " at offset: " .. tostring(offset))

	return offset, currentCount + 1
end

function MapOffsetManager.releaseMap(mapName)
	if MapOffsetManager.MapUsage[mapName] then
		MapOffsetManager.MapUsage[mapName] = math.max(0, MapOffsetManager.MapUsage[mapName] - 1)
		print("🗺️ Map '" .. mapName .. "' - Released. Active instances: " .. MapOffsetManager.MapUsage[mapName])
	end
end


local Match = {}
Match.__index = Match

function Match.new(matchId, padSet, player1, player2)
	local self = setmetatable({}, Match)

	self.MatchId = matchId
	self.PadSet = padSet
	self.Player1 = player1
	self.Player2 = player2
	self.Score1 = 0
	self.Score2 = 0
	self.CurrentMap = nil
	self.MapInstanceNumber = nil
	self.IsActive = true
	self.VotingActive = false
	self.CoinsAwarded = false
	self.WinPointAwarded = false
	self.RoundActive = false
	self.MapInstance = nil
	self.TPConnection = nil
	self.RoomPart = nil
	self.Spawn1 = nil
	self.Spawn2 = nil
	self.TPPart = nil
	self.PlayerConnections = {}
	self.PlayerVotes = {}
	self.RSParts = {}
	self.P1ScoreValue = nil
	self.P2ScoreValue = nil

	print("🎮 Match " .. matchId .. " created: " .. player1.Name .. " vs " .. player2.Name)

	self:createMatchScores()

	return self
end

function Match:createMatchScores()
	print("==========================================================")
	print("🔧 Match " .. self.MatchId .. " - Creating IntValues")
	print("==========================================================")

	self.P1ScoreValue = Instance.new("IntValue")
	self.P1ScoreValue.Name = "Match" .. self.MatchId .. "_P1Score"
	self.P1ScoreValue.Value = 0
	self.P1ScoreValue.Parent = ScoresFolder

	self.P2ScoreValue = Instance.new("IntValue")
	self.P2ScoreValue.Name = "Match" .. self.MatchId .. "_P2Score"
	self.P2ScoreValue.Value = 0
	self.P2ScoreValue.Parent = ScoresFolder

	print("✅ Created IntValues:")
	print("   " .. self.P1ScoreValue.Name)
	print("   " .. self.P2ScoreValue.Name)
	print("==========================================================")
end

function Match:setRSBarriers(enabled)
	if #self.RSParts == 0 then
		warn("⚠️ No RS parts found for Match " .. self.MatchId)
		return
	end

	for _, part in ipairs(self.RSParts) do
		if part and part.Parent then
			part.CanCollide = enabled
			part.Transparency = 1
		end
	end

	local status = enabled and "ENABLED (Anti-Exploit)" or "DISABLED (Round Active)"
	print("🛡️ Match " .. self.MatchId .. " - RS Barriers " .. status)
end

function Match:giveGuiToPlayer(player)
	if not player or not player.Parent then return end

	local playerGui = player:WaitForChild("PlayerGui", 5)
	if not playerGui then
		warn("❌ PlayerGui not found for " .. player.Name)
		return
	end

	local existingGui = playerGui:FindFirstChild("BattleGui_Match" .. self.MatchId)
	if existingGui then
		print("⚠️ " .. player.Name .. " already has GUI for Match " .. self.MatchId)
		return
	end

	local originalGui = StarterGui:FindFirstChild("BattleGui")
	if not originalGui then
		warn("❌ BattleGui not found in StarterGui!")
		return
	end

	local guiClone = originalGui:Clone()
	guiClone.Name = "BattleGui_Match" .. self.MatchId
	guiClone.Enabled = true
	guiClone.ResetOnSpawn = false

	local matchIdValue = Instance.new("IntValue")
	matchIdValue.Name = "MatchId"
	matchIdValue.Value = self.MatchId
	matchIdValue.Parent = guiClone

	guiClone.Parent = playerGui

	print("✅ Gave BattleGui_Match" .. self.MatchId .. " to " .. player.Name)
end

function Match:updateBattleGui()
	if self.P1ScoreValue then
		self.P1ScoreValue.Value = self.Score1
	end
	if self.P2ScoreValue then
		self.P2ScoreValue.Value = self.Score2
	end

	print("📊 Match " .. self.MatchId .. " - Updated scores: " .. self.Score1 .. "-" .. self.Score2)
end

function Match:hideBattleGui()
	print("🧹 Match " .. self.MatchId .. " - Hiding GUIs")

	for _, player in ipairs({self.Player1, self.Player2}) do
		if player and player.Parent then
			local playerGui = player:FindFirstChild("PlayerGui")
			if playerGui then
				local guiName = "BattleGui_Match" .. self.MatchId
				local gui = playerGui:FindFirstChild(guiName)
				if gui then
					gui:Destroy()
					print("✅ Destroyed GUI from " .. player.Name)
				end
			end
		end
	end

	task.wait(0.5)
end

function Match:cleanup()
	print("🧹 Match " .. self.MatchId .. " - Starting cleanup")

	self:hideBattleGui()

	task.wait(0.5)

	if self.CurrentMap then
		MapOffsetManager.releaseMap(self.CurrentMap)
	end

	if self.P1ScoreValue and self.P1ScoreValue.Parent then
		self.P1ScoreValue:Destroy()
		self.P1ScoreValue = nil
	end
	if self.P2ScoreValue and self.P2ScoreValue.Parent then
		self.P2ScoreValue:Destroy()
		self.P2ScoreValue = nil
	end
	print("✅ Destroyed IntValues")

	if self.MapInstance then
		self.MapInstance:Destroy()
		self.MapInstance = nil
	end

	self.RSParts = {}

	if self.TPConnection then
		self.TPConnection:Disconnect()
		self.TPConnection = nil
	end

	for _, conn in pairs(self.PlayerConnections) do
		if conn then
			conn:Disconnect()
		end
	end
	self.PlayerConnections = {}

	self.IsActive = false
	print("✅ Match " .. self.MatchId .. " cleanup complete")
end

function Match:startVoting()
	self.VotingActive = true
	print("🗳️ Match " .. self.MatchId .. " - Starting voting...")

	local spawn1, spawn2
	if self.PadSet == "Pads12" then
		spawn1 = Workspace:WaitForChild("Spawn 1")
		spawn2 = Workspace:WaitForChild("Spawn 2")
	else
		spawn1 = Workspace:WaitForChild("Spawn 3")
		spawn2 = Workspace:WaitForChild("Spawn 4")
	end

	teleportPlayerNoRespawn(self.Player1, spawn1)
	teleportPlayerNoRespawn(self.Player2, spawn2)

	task.wait(1)

	local MapVoteEvent = ReplicatedStorage:WaitForChild("MapVoteEvent")
	if MapVoteEvent then
		MapVoteEvent:FireClient(self.Player1, "SHOW_GUIS")
		MapVoteEvent:FireClient(self.Player2, "SHOW_GUIS")
		MapVoteEvent:FireClient(self.Player1, "RESET_VOTES")
		MapVoteEvent:FireClient(self.Player2, "RESET_VOTES")

		for _, player in ipairs({self.Player1, self.Player2}) do
			if player and player.Parent then
				task.spawn(function()
					local playerGui = player:WaitForChild("PlayerGui")
					local jumpGui = playerGui:FindFirstChild("JumpBasesGUI")
					local bridgeGui = playerGui:FindFirstChild("BridgeGUI")
					local castleGui = playerGui:FindFirstChild("CastleGUI")

					if jumpGui then jumpGui.Enabled = true end
					if bridgeGui then bridgeGui.Enabled = true end
					if castleGui then castleGui.Enabled = true end
				end)
			end
		end
	end

	for i = 5, 1, -1 do
		if not self.IsActive then break end
		task.wait(1)
	end

	self.VotingActive = false

	if MapVoteEvent then
		MapVoteEvent:FireClient(self.Player1, "HIDE_GUIS")
		MapVoteEvent:FireClient(self.Player2, "HIDE_GUIS")

		for _, player in ipairs({self.Player1, self.Player2}) do
			if player and player.Parent then
				task.spawn(function()
					local playerGui = player:WaitForChild("PlayerGui")
					local jumpGui = playerGui:FindFirstChild("JumpBasesGUI")
					local bridgeGui = playerGui:FindFirstChild("BridgeGUI")
					local castleGui = playerGui:FindFirstChild("CastleGUI")

					if jumpGui then jumpGui.Enabled = false end
					if bridgeGui then bridgeGui.Enabled = false end
					if castleGui then castleGui.Enabled = false end
				end)
			end
		end
	end

	self:determineMapFromVotes()
	print("🗺️ Match " .. self.MatchId .. " - Map selected: " .. self.CurrentMap)

	task.wait(1)

	self:createMapInstance()

	print("🎨 Match " .. self.MatchId .. " - Giving GUIs to players...")
	task.wait(0.5)

	self:giveGuiToPlayer(self.Player1)
	self:giveGuiToPlayer(self.Player2)

	task.wait(0.5)

	self:startRound()
end

function Match:determineMapFromVotes()
	local votes = {
		JumpBases = 0,
		Bridge = 0,
		Castle = 0
	}

	for player, mapName in pairs(self.PlayerVotes) do
		if votes[mapName] then
			votes[mapName] = votes[mapName] + 1
		end
	end

	local maxVotes = 0
	local winningMaps = {}

	for mapName, voteCount in pairs(votes) do
		if voteCount > maxVotes then
			maxVotes = voteCount
			winningMaps = {mapName}
		elseif voteCount == maxVotes and voteCount > 0 then
			table.insert(winningMaps, mapName)
		end
	end

	if #winningMaps == 0 then
		winningMaps = {"JumpBases", "Bridge", "Castle"}
	end

	self.CurrentMap = winningMaps[math.random(1, #winningMaps)]
end

function Match:createMapInstance()
	local mapTemplatesFolder = ServerStorage:FindFirstChild("MapTemplates")
	if not mapTemplatesFolder then
		warn("❌ MapTemplates folder not found!")
		return nil
	end

	local templateName = self.CurrentMap .. "_Template"
	local template = mapTemplatesFolder:FindFirstChild(templateName)

	if not template then
		template = mapTemplatesFolder:FindFirstChild(self.CurrentMap) or
			mapTemplatesFolder:FindFirstChild("Bridge_Template") or 
			mapTemplatesFolder:FindFirstChild("Castle_Template") or 
			mapTemplatesFolder:FindFirstChild("JumpBases_Template")
	end

	if not template then
		warn("❌ No map templates found!")
		return nil
	end

	local offset, instanceNumber = MapOffsetManager.getNextOffset(self.CurrentMap)
	self.MapInstanceNumber = instanceNumber

	self.MapInstance = template:Clone()
	self.MapInstance.Name = "Match_" .. self.MatchId .. "_" .. self.CurrentMap .. "_Instance" .. instanceNumber

	local activeMatchesFolder = Workspace:FindFirstChild("ActiveMatches")
	if not activeMatchesFolder then
		activeMatchesFolder = Instance.new("Folder")
		activeMatchesFolder.Name = "ActiveMatches"
		activeMatchesFolder.Parent = Workspace
	end

	self.MapInstance.Parent = activeMatchesFolder

	print("🔧 Applying offset: " .. tostring(offset))
	for _, descendant in pairs(self.MapInstance:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.CFrame = descendant.CFrame + offset
		end
	end

	for _, child in pairs(self.MapInstance:GetDescendants()) do
		if child.Name == "Spawn1" or child.Name == "Spawn 1" then
			self.Spawn1 = child
		elseif child.Name == "Spawn2" or child.Name == "Spawn 2" then
			self.Spawn2 = child
		elseif child.Name == "TPPart" or child.Name:find("TP") then
			self.TPPart = child
		elseif child.Name == "Room" then
			self.RoomPart = child
		elseif child.Name == "RS" and child:IsA("BasePart") then
			table.insert(self.RSParts, child)
			child.Transparency = 1
			child.CanCollide = false
			child.Anchored = true
		end
	end

	print("✅ Match " .. self.MatchId .. " - Map created: " .. self.CurrentMap .. " (Instance #" .. instanceNumber .. ")")
	print("   Offset: " .. tostring(offset))
	print("   🛡️ Found " .. #self.RSParts .. " RS barrier parts")

	if self.Spawn1 then
		print("   Spawn1 at: " .. tostring(self.Spawn1.Position))
	end
	if self.Spawn2 then
		print("   Spawn2 at: " .. tostring(self.Spawn2.Position))
	end

	return self.MapInstance
end

function Match:startRound()
	if not self.IsActive then return end

	print("🔄 Match " .. self.MatchId .. " - Starting round")

	if self.Spawn1 and self.Player1 and self.Player1.Parent then
		teleportPlayerNoRespawn(self.Player1, self.Spawn1)
	end
	if self.Spawn2 and self.Player2 and self.Player2.Parent then
		teleportPlayerNoRespawn(self.Player2, self.Spawn2)
	end

	if self.TPPart then
		if self.TPConnection then
			self.TPConnection:Disconnect()
		end
		self.TPConnection = self.TPPart.Touched:Connect(function(hit)
			self:onTPTouched(hit)
		end)
	end

	self:updateBattleGui()

	self:setRSBarriers(true)

	setPlayerSpeedZero(self.Player1, 3)
	setPlayerSpeedZero(self.Player2, 3)

	for i = 3, 1, -1 do
		if not self.IsActive then break end
		task.wait(1)
	end

	if not self.IsActive then return end

	self:setRSBarriers(false)

	giveBothTools(self.Player1)
	giveBothTools(self.Player2)

	self.RoundActive = true
	print("⚔️ Match " .. self.MatchId .. " - Round active!")
end

function Match:onTPTouched(hit)
	if not self.IsActive or not self.RoundActive then return end

	local character = hit.Parent
	if not character then return end

	local player = Players:GetPlayerFromCharacter(character)
	if not player then return end

	if player ~= self.Player1 and player ~= self.Player2 then return end

	self.RoundActive = false

	local loser = player
	local winner = (player == self.Player1) and self.Player2 or self.Player1

	if self.RoomPart then
		teleportPlayerNoRespawn(loser, self.RoomPart)
	end

	if winner == self.Player1 then
		self.Score1 = self.Score1 + 1
	else
		self.Score2 = self.Score2 + 1
	end

	print("🎯 Match " .. self.MatchId .. " - Score: " .. self.Score1 .. "-" .. self.Score2)

	self:updateBattleGui()

	if RoundPlayedSignal then
		task.spawn(function()
			RoundPlayedSignal:Fire(self.Player1)
		end)
		task.spawn(function()
			RoundPlayedSignal:Fire(self.Player2)
		end)
	end

	if self.Score1 >= 5 or self.Score2 >= 5 then
		print("🏆 Match " .. self.MatchId .. " - GAME OVER!")
		self:endMatch(winner)
	else
		task.wait(3)

		if self.Player1 and self.Player1.Parent then
			teleportPlayerNoRespawn(self.Player1, self.Spawn1)
		end
		if self.Player2 and self.Player2.Parent then
			teleportPlayerNoRespawn(self.Player2, self.Spawn2)
		end

		task.wait(0.5)
		self:startRound()
	end
end

function Match:endMatch(winner)
	if not self.IsActive then return end

	local loser = (winner == self.Player1) and self.Player2 or self.Player1

	print("==========================================================")
	print("🏆 MATCH " .. self.MatchId .. " ENDED")
	print("   Winner: " .. winner.Name)
	print("   Final: " .. self.Score1 .. " - " .. self.Score2)
	print("   Map: " .. self.CurrentMap .. " (Instance #" .. self.MapInstanceNumber .. ")")
	print("==========================================================")

	if not self.CoinsAwarded then
		self.CoinsAwarded = true

		local winnerCoins = getMultipliedCoins(winner, 150)
		addCoins(winner, winnerCoins)
		print("💰 Winner " .. winner.Name .. " earned: " .. winnerCoins .. " coins")

		local loserCoins = getMultipliedCoins(loser, 50)
		addCoins(loser, loserCoins)
		print("💰 Loser " .. loser.Name .. " earned: " .. loserCoins .. " coins")
	end

	if not self.WinPointAwarded then
		self.WinPointAwarded = true

		addWin(winner)

		if WinSignal and WinSignal:IsA("BindableEvent") then
			task.spawn(function()
				WinSignal:Fire(winner)
				print("✅ WinSignal FIRED for " .. winner.Name)
			end)
		end

		incrementWinStreak(winner)
		resetWinStreak(loser)
	end

	self:hideBattleGui()

	task.wait(1)

	local lobbySpawn = Workspace:WaitForChild("LobbySpawn")
	if lobbySpawn then
		if self.Player1 and self.Player1.Parent then
			if self.Player1:FindFirstChild("InDuel") then
				self.Player1.InDuel:Destroy()
			end
			forceRespawnAndTeleport(self.Player1, lobbySpawn)
		end
		if self.Player2 and self.Player2.Parent then
			if self.Player2:FindFirstChild("InDuel") then
				self.Player2.InDuel:Destroy()
			end
			forceRespawnAndTeleport(self.Player2, lobbySpawn)
		end
	end

	task.wait(2)
	self:cleanup()
end

function Match:handlePlayerLeft(player)
	if not self.IsActive then return end

	print("⚠️ Player left: " .. player.Name)

	local otherPlayer = (player == self.Player1) and self.Player2 or self.Player1

	resetWinStreak(player)
	self:hideBattleGui()

	if otherPlayer and otherPlayer.Parent then
		local lobbySpawn = Workspace:WaitForChild("LobbySpawn")
		if lobbySpawn then
			if otherPlayer:FindFirstChild("InDuel") then
				otherPlayer.InDuel:Destroy()
			end
			forceRespawnAndTeleport(otherPlayer, lobbySpawn)
		end
	end

	self:cleanup()
end


local SkinDatabase = require(script.Parent:WaitForChild("SkinDatabase"))

function loadPlayerInventory(player)
	local userId = tostring(player.UserId)
	if PlayerInventories[userId] then
		return PlayerInventories[userId]
	end
	local success, inventory = pcall(function()
		return InventoryDataStore:GetAsync(userId)
	end)
	if success and inventory then
		if not inventory.skins or type(inventory.skins) ~= "table" then
			inventory.skins = {}
		end
		if not inventory.bombs or type(inventory.bombs) ~= "table" then
			inventory.bombs = {}
		end

		local defaultSlap = SkinDatabase:GetDefaultSkin("Slap")
		local defaultBomb = SkinDatabase:GetDefaultSkin("Bomb")

		if not inventory.skins[defaultSlap.Name] then
			inventory.skins[defaultSlap.Name] = 1
		end
		if not inventory.bombs[defaultBomb.Name] then
			inventory.bombs[defaultBomb.Name] = 1
		end

		if not inventory.equippedSlap then
			inventory.equippedSlap = defaultSlap.Name
		end
		if not inventory.equippedBomb then
			inventory.equippedBomb = defaultBomb.Name
		end


-- =======================
-- PAD DETECTION
-- =======================
function isPlayerOnPad(player, pad)
	if not player or not player.Character then return false end
	local character = player.Character
	local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
	if not humanoidRootPart then return false end
	local playerPos = humanoidRootPart.Position
	local padPos = pad.Position
	local padSize = pad.Size
	local minX = padPos.X - padSize.X/2
	local maxX = padPos.X + padSize.X/2
	local minZ = padPos.Z - padSize.Z/2
	local maxZ = padPos.Z + padSize.Z/2
	return playerPos.X >= minX and playerPos.X <= maxX and
		playerPos.Z >= minZ and playerPos.Z <= maxZ
end

function updatePadOccupants()
	for _, player in pairs(Players:GetPlayers()) do
		if MatchManager.getMatchForPlayer(player) then
			continue
		end

		local pads = {
			{pad = pad1, name = "Pad1", ui = ui1, screen = 1},
			{pad = pad2, name = "Pad2", ui = ui2, screen = 1},
			{pad = pad3, name = "Pad3", ui = ui3, screen = 2},
			{pad = pad4, name = "Pad4", ui = ui4, screen = 2}
		}

		for _, padInfo in ipairs(pads) do
			if isPlayerOnPad(player, padInfo.pad) then
				local currentOccupant = MatchManager.getPlayerOnPad(padInfo.name)
				if not currentOccupant then
					MatchManager.occupyPad(padInfo.name, player)
					updateSide(player, padInfo.ui, padInfo.screen)
				end
			else
				local currentOccupant = MatchManager.getPlayerOnPad(padInfo.name)
				if currentOccupant == player then
					MatchManager.releasePad(padInfo.name)
					updateSide(nil, padInfo.ui, padInfo.screen)
				end
			end
		end
	end
end

function updateSide(player, uiElements, screenNum)
	if player and player.Parent then
		uiElements.status.Text = "READY"
		uiElements.status.TextColor3 = Color3.fromRGB(0, 255, 0)
		uiElements.name.Text = player.Name
		uiElements.name.Visible = true
		uiElements.img.Visible = true
		local userId = player.UserId
		uiElements.img.Image = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. userId .. "&width=100&height=100&format=png"
	else
		uiElements.status.Text = "WAITING"
		uiElements.status.TextColor3 = Color3.fromRGB(255, 255, 255)
		uiElements.name.Visible = false
		uiElements.img.Visible = false
	end
end

-- =======================
-- COUNTDOWN SYSTEM
-- =======================
local padCountdowns = {
	Pad1 = false,
	Pad2 = false,
	Pad3 = false,
	Pad4 = false
}

function startCountdown(padSet)
	local pad1Name, pad2Name, timerLabel

	if padSet == "Pads12" then
		pad1Name = "Pad1"
		pad2Name = "Pad2"
		timerLabel = timerLabel1
	elseif padSet == "Pads34" then
		pad1Name = "Pad3"
		pad2Name = "Pad4"
		timerLabel = timerLabel2
	else
		return
	end

	local player1 = MatchManager.getPlayerOnPad(pad1Name)
	local player2 = MatchManager.getPlayerOnPad(pad2Name)

	if not player1 or not player2 then return end

	timerLabel.Text = "5"
	timerLabel.TextColor3 = Color3.fromRGB(255, 255, 0)

	for i = 5, 1, -1 do
		local currentPlayer1 = MatchManager.getPlayerOnPad(pad1Name)
		local currentPlayer2 = MatchManager.getPlayerOnPad(pad2Name)

		if currentPlayer1 ~= player1 or currentPlayer2 ~= player2 then
			timerLabel.Text = "WAITING"
			timerLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
			return
		end

		timerLabel.Text = tostring(i)
		task.wait(1)
	end

	timerLabel.Text = "MATCH START!"
	timerLabel.TextColor3 = Color3.fromRGB(0, 255, 0)

	MatchManager.createMatch(padSet, player1, player2)

	if padSet == "Pads12" then
		updateSide(nil, ui1, 1)
		updateSide(nil, ui2, 1)
	else
		updateSide(nil, ui3, 2)
		updateSide(nil, ui4, 2)
	end

	task.wait(2)
	timerLabel.Text = "WAITING"
	timerLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
end

-- =======================
-- MAIN GAME LOOP
-- =======================
task.spawn(function()
	while true do
		updatePadOccupants()

		local padPairs = {
			{pad1 = "Pad1", pad2 = "Pad2", set = "Pads12", label = timerLabel1},
			{pad1 = "Pad3", pad2 = "Pad4", set = "Pads34", label = timerLabel2}
		}

		for _, pair in ipairs(padPairs) do
			local player1 = MatchManager.getPlayerOnPad(pair.pad1)
			local player2 = MatchManager.getPlayerOnPad(pair.pad2)

			if player1 and player2 then
				if not padCountdowns[pair.pad1] then
					padCountdowns[pair.pad1] = true
					padCountdowns[pair.pad2] = true

					task.spawn(function()
						startCountdown(pair.set)
						padCountdowns[pair.pad1] = false
						padCountdowns[pair.pad2] = false
					end)
				end
			else
				if not player1 and not player2 and pair.label.Text ~= "WAITING" then
					pair.label.Text = "WAITING"
					pair.label.TextColor3 = Color3.fromRGB(255, 255, 255)
				end
			end
		end

		task.wait(0.5)
	end
end)


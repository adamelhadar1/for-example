	end
	return 0
end

function setCoins(player, amount)
	if not player then return end
	local userId = tostring(player.UserId)
	PlayerCoins[userId] = math.max(0, amount)
	task.spawn(function()
		pcall(function()
			CoinDataStore:SetAsync(userId, PlayerCoins[userId])
		end)
	end)
	updateCoinDisplay(player)
end

